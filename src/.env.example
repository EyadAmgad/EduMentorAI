# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-your-secret-key-here

# Database Configuration (Aiven PostgreSQL)
# Set USE_SQLITE=False to use PostgreSQL, True for local SQLite
USE_SQLITE=False
DB_NAME=your-database-name
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=12345

# Email Configuration (Gmail SMTP)
# To use Gmail SMTP, you need to:
# 1. Enable 2-factor authentication on your Gmail account
# 2. Generate an "App Password" for this application
# 3. Use your Gmail address and the app password below

EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Optional: Override default email settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Application URLs
DEFAULT_FROM_EMAIL=EduMentorAI <your-email@gmail.com>
SERVER_EMAIL=your-email@gmail.com

# AI API Keys
OPEN_ROUTER_API_KEY=

EMBEDDING_MODEL=
LLM_MODEL=